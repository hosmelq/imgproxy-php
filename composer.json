{
    "name": "hosmelq/imgproxy",
    "description": "Build imgproxy URLs in PHP with optional encryption and signing.",
    "license": "MIT",
    "keywords": [
        "encryption",
        "image-processing",
        "image-transforms",
        "imgproxy",
        "imgproxy-php",
        "php",
        "signed-urls",
        "url-builder"
    ],
    "authors": [
        {
            "name": "Hosmel Quintana",
            "email": "hosmelq@gmail.com"
        }
    ],
    "homepage": "https://github.com/hosmelq/imgproxy-php",
    "support": {
        "docs": "https://github.com/hosmelq/imgproxy-php#readme"
    },
    "require": {
        "php": "^8.4",
        "ext-openssl": "*",
        "thecodingmachine/safe": "^3.4.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.57.0",
        "hosmelq/php-coding-standard": "^1.5.0",
        "pestphp/pest": "^5.3.6",
        "pestphp/pest-plugin-agent": "^5.0.0",
        "pestphp/pest-plugin-rector": "^5.0.6",
        "shipmonk/composer-dependency-analyser": "^1.8.4"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "HosmelQ\\Imgproxy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HosmelQ\\Imgproxy\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "ecs": "ecs check --fix",
        "phpstan": "phpstan analyse --memory-limit=4G",
        "rector": "rector",
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "scripts-descriptions": {
        "ecs": "Runs ECS.",
        "phpstan": "Runs PHPStan analyse.",
        "rector": "Runs Rector.",
        "test": "Runs the Pest test suite.",
        "test-coverage": "Runs the Pest test suite with code coverage."
    },
    "$schema": "https://getcomposer.org/schema.json"
}
